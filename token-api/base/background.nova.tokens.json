{
  "color": {
    "box": {
      "@base": {
        "$value": "{color.white.@base}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{color.white.@base}",
            "dark": "{color.gray.70}",
            "forcedColors": "{background.color.canvas}"
          }
        },
        "$type": "color"
      },
      "info": {
        "$value": "{color.gray.15}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{color.gray.15}",
            "dark": "{color.gray.65}",
            "forcedColors": "{background.color.canvas}"
          }
        },
        "$type": "color"
      }
    },
    "canvas": {
      "$value": "{color.gray.05}",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "{color.gray.05}",
          "dark": "{color.gray.85}",
          "forcedColors": "Canvas"
        }
      },
      "$type": "color"
    },
    "critical": {
      "$value": "{color.red.10}",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "{color.red.10}",
          "dark": "{color.red.70}",
          "forcedColors": "{background.color.canvas}"
        }
      },
      "$type": "color"
    },
    "information": {
      "$value": "{color.violet.10}",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "{color.violet.10}",
          "dark": "{color.violet.70}",
          "forcedColors": "{background.color.canvas}"
        }
      },
      "$type": "color"
    },
    "success": {
      "$value": "{color.green.10}",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "{color.green.10}",
          "dark": "{color.green.70}",
          "forcedColors": "{background.color.canvas}"
        }
      },
      "$type": "color"
    },
    "warning": {
      "$value": "{color.yellow.10}",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "{color.yellow.10}",
          "dark": "{color.yellow.70}",
          "forcedColors": "{background.color.canvas}"
        }
      },
      "$type": "color"
    }
  }
}
