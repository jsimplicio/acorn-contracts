{
  "color": {
    "box": {
      "@base": {
        "$value": "{color.white.@base}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{color.white.@base}",
            "dark": "{color.gray.80}",
            "prefersContrast": "{background.color.canvas}"
          }
        },
        "$type": "color"
      },
      "info": {
        "$value": "{color.gray.20}",
        "$extensions": {
          "org.mozilla.themes": {
            "prefersContrast": "{background.color.canvas}",
            "brand": {
              "light": "{color.gray.20}",
              "dark": "{color.gray.80}"
            },
            "platform": {
              "default": "color-mix(in srgb, currentColor 6%, transparent)"
            }
          }
        },
        "$type": "color"
      }
    },
    "canvas": {
      "$value": "{color.white.@base}",
      "$extensions": {
        "org.mozilla.themes": {
          "prefersContrast": "Canvas",
          "brand": {
            "light": "{color.white.@base}",
            "dark": "{color.gray.90}"
          },
          "platform": {
            "default": "Canvas"
          }
        }
      },
      "$type": "color"
    },
    "critical": {
      "$value": "{color.red.0}",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "{color.red.0}",
          "dark": "{color.red.90}",
          "prefersContrast": "{background.color.canvas}"
        }
      },
      "$type": "color"
    },
    "information": {
      "$value": "{color.blue.0}",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "{color.blue.0}",
          "dark": "{color.blue.90}",
          "prefersContrast": "{background.color.canvas}"
        }
      },
      "$type": "color"
    },
    "success": {
      "$value": "{color.green.0}",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "{color.green.0}",
          "dark": "{color.green.90}",
          "prefersContrast": "{background.color.canvas}"
        }
      },
      "$type": "color"
    },
    "warning": {
      "$value": "{color.yellow.0}",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "{color.yellow.0}",
          "dark": "{color.yellow.90}",
          "prefersContrast": "{background.color.canvas}"
        }
      },
      "$type": "color"
    },
    "overlay": {
      "$value": "{color.black.alpha.50}",
      "$type": "color"
    },
    "list": {
      "item": {
        "hover": {
          "$value": "color-mix(in srgb, {color.accent.primary.@base} 20%, transparent)",
          "$extensions": {
            "org.mozilla.themes": {
              "brand": {
                "default": "color-mix(in srgb, {color.accent.primary.@base} 20%, transparent)"
              },
              "platform": {
                "default": "color-mix(in srgb, currentColor 20%, transparent)"
              },
              "prefersContrast": "SelectedItem"
            }
          },
          "$type": "color"
        }
      }
    },
    "dimmed": {
      "@base": {
        "$value": "color-mix(in srgb, currentColor 12%, transparent)",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "color-mix(in srgb, currentColor 12%, transparent)",
            "dark": "color-mix(in srgb, currentColor 17%, transparent)",
            "nativeTheme": "color-mix(in srgb, currentColor 17%, transparent)"
          }
        },
        "$type": "color"
      },
      "further": {
        "$value": "color-mix(in srgb, currentColor 20%, transparent)",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "color-mix(in srgb, currentColor 20%, transparent)",
            "dark": "color-mix(in srgb, currentColor 14%, transparent)",
            "nativeTheme": "color-mix(in srgb, currentColor 30%, transparent)"
          }
        },
        "$type": "color"
      }
    }
  }
}
