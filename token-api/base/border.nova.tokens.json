{
  "color": {
    "interactive": {
      "hover": {
        "$value": "{color.gray.50}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{color.gray.50}",
            "dark": "{color.gray.20}",
            "forcedColors": "SelectedItem"
          }
        },
        "$type": "color"
      },
      "active": {
        "$value": "{color.gray.50}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{color.gray.50}",
            "dark": "{color.gray.15}",
            "forcedColors": "ButtonText"
          }
        },
        "$type": "color"
      },
      "disabled": {
        "$value": "{color.gray.25}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{color.gray.25}",
            "dark": "{color.gray.55}",
            "forcedColors": "GrayText"
          }
        },
        "$type": "color"
      }
    }
  },
  "radius": {
    "xsmall": {
      "$value": "4px",
      "$type": "dimension"
    },
    "small": {
      "$value": "8px",
      "$type": "dimension"
    },
    "medium": {
      "$value": "12px",
      "$type": "dimension"
    },
    "xlarge": {
      "$value": "24px",
      "$type": "dimension"
    }
  }
}
