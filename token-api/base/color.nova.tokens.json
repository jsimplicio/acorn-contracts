  "accent": {
    "primary": {
      "@base": {
        "$value": "{color.violet.50}",
        "$extensions": {
          "org.mozilla.themes": {
            "nativeTheme": "AccentColor",
            "light": "{color.violet.50}",
            "dark": "{color.violet.30}",
            "forcedColors": "ButtonText"
          }
        },
        "$type": "color"
      },
      "hover": {
        "$value": "{color.violet.60}",
        "$extensions": {
          "org.mozilla.themes": {
            "nativeTheme": "color-mix(in srgb, black 10%, {color.accent.primary.@base})",
            "light": "{color.violet.60}",
            "dark": "{color.violet.20}",
            "forcedColors": "SelectedItem"
          }
        },
        "$type": "color"
      },
      "active": {
        "$value": "{color.violet.70}",
        "$extensions": {
          "org.mozilla.themes": {
            "nativeTheme": "color-mix(in srgb, black 20%, {color.accent.primary.@base})",
            "light": "{color.violet.70}",
            "dark": "{color.violet.10}",
            "forcedColors": "{color.accent.primary.hover}"
          }
        },
        "$type": "color"
      },
      "selected": {
        "$value": "{button.background.color.primary.active}",
        "$extensions": {
          "org.mozilla.themes": {
            "nativeTheme": "SelectedItem",
            "default": "{button.background.color.primary.active}",
            "forcedColors": "SelectedItem"
          }
        },
        "$type": "color"
      }
    },
    "attention": {
      "$value": "{color.green.40}",
      "$extensions": {
        "org.mozilla.themes": {
          "nativeTheme": "AccentColor",
          "light": "{color.green.40}",
          "dark": "{color.green.30}",
          "forcedColors": "AccentColor"
        }
      },
      "$type": "color"
    }
  }
