  "accent": {
    "primary": {
      "@base": {
        "$value": "{color.blue.60}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{color.blue.60}",
            "dark": "{color.cyan.30}",
            "nativeTheme": "AccentColor",
            "forcedColors": "ButtonText"
          }
        },
        "$type": "color"
      },
      "hover": {
        "$value": "{color.blue.70}",
        "$extensions": {
          "org.mozilla.themes": {
            "forcedColors": "SelectedItem",
            "light": "{color.blue.70}",
            "dark": "{color.cyan.20}",
            "nativeTheme": "color-mix(in srgb, black 10%, {color.accent.primary.@base})"
          }
        },
        "$type": "color"
      },
      "active": {
        "$value": "{color.blue.80}",
        "$extensions": {
          "org.mozilla.themes": {
            "forcedColors": "{color.accent.primary.hover}",
            "light": "{color.blue.80}",
            "dark": "{color.cyan.10}",
            "nativeTheme": "color-mix(in srgb, black 20%, {color.accent.primary.@base})"
          }
        },
        "$type": "color"
      },
      "selected": {
        "$value": "{color.blue.60}",
        "$extensions": {
          "org.mozilla.themes": {
            "forcedColors": "SelectedItem",
            "light": "{color.blue.60}",
            "dark": "{color.cyan.30}",
            "nativeTheme": "SelectedItem"
          }
        },
        "$type": "color"
      }
    },
    "attention": {
      "$value": "#2ac3a2",
      "$extensions": {
        "org.mozilla.themes": {
          "prefersContrast": "AccentColor",
          "light": "#2ac3a2",
          "dark": "#54ffbd",
          "nativeTheme": "AccentColor"
        }
      },
      "$type": "color"
    }
  }
