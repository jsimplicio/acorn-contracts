        "selected": {
          "$value": "{button.background.color.destructive.active}",
          "$type": "color"
        }
      },
      "ghost": {
        "@base": {
          "$value": "transparent",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "transparent",
              "forcedColors": "ButtonFace",
              "brand": {
                "forcedColors": "ButtonFace"
              },
              "nativeTheme": "transparent"
            }
          },
          "$type": "color"
        },
        "active": {
          "$value": "{button.background.color.active}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{button.background.color.ghost.@base}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{button.background.color.ghost.@base}",
              "brand": {
                "forcedColors": "{button.background.color.disabled}"
              }
            },
            "org.mozilla.meta": {
              "ignoreFigma": "Preserve token structure that can't be replicated in Figma"
            }
          },
          "$type": "color"
        },
        "hover": {
          "$value": "{button.background.color.hover}",
          "$type": "color"
        },
        "selected": {
          "$value": "{button.background.color.ghost.active}",
          "$type": "color"
        }
      },
      "muted": {
        "@base": {
          "$value": "{button.background.color.@base}",
          "$type": "color"
        },
        "active": {
          "$value": "{button.background.color.active}",
          "$type": "color"
        },
        "hover": {
          "$value": "{button.background.color.hover}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{button.background.color.disabled}",
          "$type": "color"
        },
        "selected": {
          "$value": "{button.background.color.muted.active}",
          "$type": "color"
        }
      },
      "menu": {
        "@base": {
          "$value": "{button.background.color.ghost.@base}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{button.background.color.ghost.@base}",
              "forcedColors": "Menu"
            }
          },
          "$type": "color"
        },
        "active": {
          "$value": "{button.background.color.ghost.active}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{button.background.color.ghost.active}",
              "forcedColors": "{button.background.color.menu.hover}"
            }
          },
          "$type": "color"
        },
        "disabled": {
          "$value": "{button.background.color.ghost.disabled}",
          "$type": "color"
        },
        "hover": {
          "$value": "{button.background.color.ghost.hover}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{button.background.color.ghost.hover}",
              "forcedColors": "-moz-menuhover"
            }
          },
          "$type": "color"
        },
        "selected": {
          "$value": "{button.background.color.ghost.selected}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{button.background.color.ghost.selected}",
              "forcedColors": "{button.background.color.primary.selected}"
            }
          },
          "$type": "color"
        }
      },
      "selected": {
        "$value": "{button.background.color.active}",
        "$type": "color"
      },
      "toolbar": {
        "@base": {
          "$value": "{toolbarbutton.background.color.@base}",
          "$type": "color"
        },
        "hover": {
          "$value": "{toolbarbutton.background.color.hover}",
          "$type": "color"
        },
        "active": {
          "$value": "{toolbarbutton.background.color.active}",
          "$type": "color"
        },
        "disabled": {
          "$value": "{toolbarbutton.background.color.@base}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{toolbarbutton.background.color.@base}",
              "forcedColors": "{button.background.color.disabled}"
            }
          },
          "$type": "color"
        },
        "selected": {
          "$value": "{button.background.color.ghost.active}",
          "$type": "color"
        }
      }
    }
  },
  "badge": {
    "background": {
      "color": {
        "$value": "{color.accent.attention}",
        "$type": "color"
      }
    },
    "size": {
      "$value": "6px",
      "$type": "dimension"
