          "$type": "color"
        },
        "selected": {
          "$value": "{button.background.color.primary.active}",
          "$type": "color"
        }
      },
      "destructive": {
        "@base": {
          "$value": "{color.red.60}",
          "$extensions": {
            "org.mozilla.themes": {
              "light": "{color.red.60}",
              "dark": "{color.red.30}",
              "forcedColors": "{button.background.color.primary.@base}"
