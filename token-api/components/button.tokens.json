{
  "background": {
    "color": {
      "@base": {
        "$value": "color-mix(in srgb, currentColor 7%, transparent)",
        "$extensions": {
          "org.mozilla.themes": {
            "forcedColors": "ButtonFace",
            "brand": {
              "default": "color-mix(in srgb, currentColor 7%, transparent)"
            },
            "nativeTheme": "color-mix(in srgb, currentColor 13%, transparent)",
            "platform": {
              "light": "rgba(207, 207, 216, 0.33)",
              "dark": "rgba(0, 0, 0, 0.33)"
            },
            "nova": {
              "value": {
                "default": "transparent",
                "forcedColors": "ButtonFace"
              }
            }
          }
        },
        "$description": "TODO Bug 1821203 - Gray use needs to be consolidated",
        "$type": "color"
      },
      "hover": {
        "$value": "color-mix(in srgb, currentColor 14%, transparent)",
        "$extensions": {
          "org.mozilla.themes": {
            "forcedColors": "SelectedItemText",
            "brand": {
              "default": "color-mix(in srgb, currentColor 14%, transparent)"
            },
            "nativeTheme": "color-mix(in srgb, currentColor 17%, transparent)",
            "platform": {
              "light": "rgba(207, 207, 216, 0.66)",
              "dark": "rgba(207, 207, 216, 0.2)"
            },
            "nova": {
              "value": {
                "nativeTheme": "color-mix(in srgb, AccentColor 20%, transparent)",
                "light": "{color.violet-desaturated.20}",
                "dark": "{color.violet-desaturated.50}",
                "forcedColors": "SelectedItemText"
              }
            }
          }
        },
        "$type": "color"
      },
      "active": {
        "$value": "color-mix(in srgb, currentColor 21%, transparent)",
        "$extensions": {
          "org.mozilla.themes": {
            "forcedColors": "SelectedItemText",
            "brand": {
              "default": "color-mix(in srgb, currentColor 21%, transparent)"
            },
            "nativeTheme": "color-mix(in srgb, currentColor 30%, transparent)",
            "platform": {
              "light": "rgb(207, 207, 216)",
              "dark": "rgba(207, 207, 216, 0.4)"
            },
            "nova": {
              "value": {
                "nativeTheme": "color-mix(in srgb, AccentColor 30%, transparent)",
                "light": "{color.violet-desaturated.30}",
                "dark": "{color.violet-desaturated.40}",
                "forcedColors": "SelectedItemText"
              }
            }
          }
        },
        "$type": "color"
      },
      "disabled": {
        "$value": "{button.background.color.@base}",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "{button.background.color.@base}",
            "forcedColors": "ButtonFace"
          }
        },
        "$type": "color"
      },
      "primary": {
        "@base": {
          "$value": "{color.accent.primary.@base}",
          "$extensions": {
