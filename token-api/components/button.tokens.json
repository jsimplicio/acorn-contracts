        "active": {
          "$value": "{color.accent.primary.active}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{color.accent.primary.active}",
              "forcedColors": "{button.background.color.primary.hover}"
            }
          },
          "$type": "color"
