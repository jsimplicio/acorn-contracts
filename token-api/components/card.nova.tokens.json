{
  "gap": {
    "@base": {
      "$value": "{space.medium}",
      "$type": "dimension"
    }
  },
  "header": {
    "background": {
      "color": {
        "@base": {
          "$value": "{button.background.color.@base}",
          "$type": "color"
        }
      }
    },
    "border": {
      "color": {
        "@base": {
          "$value": "transparent",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "transparent",
              "forcedColors": "{button.border.color.@base}"
            }
          },
          "$type": "color"
        }
      }
    }
  }
}
