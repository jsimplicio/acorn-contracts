{
  "color": {
    "@base": {
      "$value": "{text.color.@base}",
      "$type": "color"
    },
    "accent": {
      "primary": {
        "desaturated": {
          "$value": "{color.violet-desaturated.60}",
          "$extensions": {
            "org.mozilla.themes": {
              "light": "{color.violet-desaturated.60}",
              "dark": "{color.violet-desaturated.40}",
              "forcedColors": "CanvasText"
            }
          },
          "$type": "color"
        }
      }
    }
  },
  "size": {
    "xsmall": {
      "$value": "{size.item.xsmall}",
      "$type": "dimension"
    },
    "small": {
      "$value": "{size.item.small}",
      "$type": "dimension"
    },
    "large": {
      "$value": "{size.item.medium}",
      "$type": "dimension"
    },
    "xlarge": {
      "$value": "{size.item.large}",
      "$type": "dimension"
    }
  }
}
