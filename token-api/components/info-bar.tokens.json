{
  "border": {
    "color": {
      "$value": "{color.violet-desaturated.20}",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "{color.violet-desaturated.20}",
          "dark": "{color.gray.60}",
          "nativeTheme": "{toolbarseparator.color}",
          "prefersContrast": "CanvasText"
        }
      },
      "$type": "color"
    }
  },
  "margin": {
    "block": {
      "start": {
        "$value": "4px",
        "$type": "dimension"
      },
      "end": {
        "$value": "4px",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "4px",
            "nova": {
              "comment": "There is no equivalent value for this token in Figma",
              "value": "0"
            }
          }
        },
        "$type": "dimension"
      }
    },
    "inline": {
      "$value": "4px",
      "$type": "dimension"
    }
  }
}
