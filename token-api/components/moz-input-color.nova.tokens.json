{
  "background": {
    "color": {
      "@base": {
        "$value": "{button.background.color.@base}",
        "$type": "color"
      },
      "active": {
        "$value": "{button.background.color.active}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{button.background.color.active}",
            "dark": "{color.violet-desaturated.60}",
            "forcedColors": "{button.background.color.active}"
          }
        },
        "$type": "color"
      },
      "hover": {
        "$value": "{button.background.color.hover}",
        "$type": "color"
      }
    }
  },
  "space": {
    "padding": {
      "inline": {
        "$value": "{space.small}",
        "$type": "dimension"
      }
    }
  }
}
