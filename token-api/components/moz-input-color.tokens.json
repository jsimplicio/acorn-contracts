{
  "background": {
    "color": {
      "@base": {
        "$value": "{button.background.color.ghost.@base}",
        "$type": "color"
      },
      "active": {
        "$value": "{button.background.color.ghost.active}",
        "$type": "color"
      },
      "hover": {
        "$value": "{button.background.color.ghost.hover}",
        "$type": "color"
      }
    }
  },
  "border": {
    "color": {
      "@base": {
        "$value": "{border.color.interactive.@base}",
        "$type": "color"
      },
      "active": {
        "$value": "{border.color.interactive.active}",
        "$type": "color"
      },
      "hover": {
        "$value": "{border.color.interactive.hover}",
        "$type": "color"
      }
    },
    "radius": {
      "$value": "{border.radius.medium}",
      "$type": "dimension"
    }
  },
  "gap": {
    "$value": "{space.small}",
    "$type": "dimension"
  },
  "space": {
