      "$value": "{size.item.medium}",
      "$type": "dimension"
    }
  },
  "text": {
    "color": {
      "@base": {
        "$value": "{button.text.color.@base}",
        "$type": "color"
      },
      "active": {
        "$value": "{button.text.color.active}",
        "$type": "color"
      },
      "hover": {
        "$value": "{button.text.color.hover}",
        "$type": "color"
      }
    }
