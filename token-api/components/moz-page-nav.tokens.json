{
  "border": {
    "color": {
      "$value": "{border.color.transparent}",
      "$type": "color"
    }
  },
  "button": {
    "background": {
      "color": {
        "@base": {
          "$value": "{button.background.color.ghost.@base}",
          "$type": "color"
        },
        "hover": {
          "$value": "{button.background.color.ghost.hover}",
          "$type": "color"
        },
        "active": {
          "$value": "{button.background.color.ghost.active}",
          "$type": "color"
        },
        "selected": {
          "$value": "color-mix(in srgb, currentColor 8%, transparent)",
          "$type": "color"
        }
      }
    },
    "border": {
      "color": {
        "@base": {
          "$value": "unset",
          "$type": "color"
        },
        "hover": {
          "$value": "{button.border.color.ghost.hover}",
          "$type": "color"
        },
        "active": {
          "$value": "{button.border.color.ghost.active}",
          "$type": "color"
        }
      },
      "radius": {
        "@base": {
          "$value": "{button.border.radius}",
          "$type": "dimension"
        },
        "focused": {
          "$value": "{border.radius.small}",
          "$type": "dimension"
        }
      }
    },
    "gap": {
      "$value": "{space.xsmall}",
      "$type": "dimension"
    },
    "indicator": {
      "background": {
        "color": {
          "$value": "{color.accent.primary.@base}",
          "$type": "color"
        }
      },
      "width": {
        "$value": "4px",
        "$type": "dimension"
      }
    },
    "padding": {
      "@base": {
        "$value": "{space.small} {space.medium}",
        "$type": "dimension"
      },
      "small": {
        "$value": "{space.small}",
        "$type": "dimension"
      }
    },
    "text": {
      "color": {
        "@base": {
          "$value": "{button.text.color.ghost.@base}",
          "$type": "color"
        },
        "hover": {
          "$value": "{button.text.color.ghost.hover}",
          "$type": "color"
        },
        "active": {
          "$value": "{button.text.color.ghost.active}",
          "$type": "color"
        },
        "selected": {
          "$value": "{color.accent.primary.@base}",
          "$type": "color"
        }
      }
    }
  },
  "focus": {
    "outline": {
      "offset": {
        "$value": "{focus.outline.inset}",
        "$type": "dimension"
      }
    },
    "padding": {
      "$value": "0px",
      "$extensions": {
        "org.mozilla.themes": {
          "default": "0px",
          "nova": {
            "comment": "There is no equivalent value for this token in Figma",
            "value": "calc({focus.outline.offset} + {focus.outline.width})"
          }
        }
      },
      "$type": "dimension"
    }
  },
  "gap": {
    "$value": "{space.large}",
    "$type": "dimension"
  },
  "heading": {
    "logo": {
      "size": {
        "$value": "{icon.size.large}",
        "$type": "dimension"
      }
    }
  },
  "hr": {
    "background": {
      "color": {
        "$value": "{border.color.@base}",
        "$type": "color"
      }
    }
  },
  "margin": {
    "block": {
      "start": {
        "$value": "{page.space.block.start}",
        "$type": "dimension"
      }
    },
    "inline": {
      "start": {
        "$value": "40px",
        "$type": "dimension"
      }
    }
  }
}
