{
  "background": {
    "color": {
      "@base": {
        "$value": "{button.background.color.@base}",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "{button.background.color.@base}",
            "nova": {
              "comment": "HCM colors for toggle need to be updated in Figma",
              "value": {
                "forcedColors": "SelectedItemText"
              }
            }
          }
        },
        "$type": "color"
      },
      "hover": {
        "$value": "{button.background.color.hover}",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "{button.background.color.hover}",
            "nova": {
              "comment": "HCM colors for toggle need to be updated in Figma",
              "value": {
                "forcedColors": "SelectedItemText"
              }
            }
          }
        },
        "$type": "color"
      },
      "active": {
        "$value": "{button.background.color.active}",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "{button.background.color.active}",
            "nova": {
              "comment": "HCM colors for toggle need to be updated in Figma",
              "value": {
                "forcedColors": "SelectedItemText"
              }
            }
          }
        },
        "$type": "color"
      },
      "pressed": {
        "@base": {
          "$value": "{color.accent.primary.@base}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{color.accent.primary.@base}",
              "nova": {
                "comment": "HCM colors for toggle need to be updated in Figma",
                "value": {
                  "default": "{button.background.color.primary.@base}",
                  "forcedColors": "ButtonText"
                }
              }
            }
          },
          "$type": "color"
        },
        "hover": {
          "$value": "{color.accent.primary.hover}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{color.accent.primary.hover}",
              "nova": {
                "comment": "HCM colors for toggle need to be updated in Figma",
                "value": {
                  "default": "{button.background.color.primary.hover}",
                  "forcedColors": "SelectedItem"
                }
              }
            }
          },
          "$type": "color"
        },
        "active": {
          "$value": "{color.accent.primary.active}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{color.accent.primary.active}",
              "nova": {
                "comment": "HCM colors for toggle need to be updated in Figma",
                "value": {
                  "default": "{button.background.color.primary.active}",
                  "forcedColors": "SelectedItem"
                }
              }
            }
          },
          "$type": "color"
        }
      }
    }
  },
  "border": {
    "color": {
      "@base": {
        "$value": "{color.gray.70}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{color.gray.70}",
            "dark": "{border.color.interactive.@base}",
            "prefersContrast": "{border.color.interactive.@base}",
            "forcedColors": "{border.color.interactive.@base}",
            "nova": {
              "comment": "HCM colors for toggle need to be updated in Figma",
              "value": {
                "default": "{border.color.interactive.@base}",
                "forcedColors": "ButtonText"
              }
            }
          }
        },
        "$type": "color"
      },
      "hover": {
        "$value": "{toggle.border.color.@base}",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "{toggle.border.color.@base}",
            "forcedColors": "{border.color.interactive.hover}",
            "nova": {
              "comment": "HCM colors for toggle need to be updated in Figma",
              "value": {
                "default": "{border.color.interactive.hover}",
                "forcedColors": "SelectedItem"
              }
            }
          }
        },
        "$type": "color"
      },
      "active": {
        "$value": "{toggle.border.color.@base}",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "{toggle.border.color.@base}",
            "forcedColors": "{border.color.interactive.active}",
            "nova": {
              "comment": "HCM colors for toggle need to be updated in Figma",
              "value": {
                "default": "{border.color.interactive.active}",
                "forcedColors": "ButtonText"
              }
            }
          }
        },
        "$type": "color"
      }
    },
    "radius": {
      "$value": "{border.radius.circle}",
      "$type": "dimension"
    },
    "width": {
      "$value": "{border.width}",
      "$type": "dimension"
    }
  },
  "height": {
    "$value": "{size.item.small}",
    "$type": "dimension"
  },
  "width": {
    "$value": "{size.item.large}",
    "$type": "dimension"
  },
  "dot": {
    "background": {
      "color": {
        "@base": {
          "$value": "{toggle.border.color.@base}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{toggle.border.color.@base}",
              "forcedColors": "{color.accent.primary.@base}",
              "nova": {
                "comment": "HCM colors for toggle need to be updated in Figma",
                "value": {
                  "forcedColors": "ButtonText"
                }
              }
            }
          },
          "$type": "color"
        },
        "hover": {
          "$value": "{toggle.dot.background.color.@base}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{toggle.dot.background.color.@base}",
              "forcedColors": "{color.accent.primary.hover}",
              "nova": {
                "comment": "HCM colors for toggle need to be updated in Figma",
                "value": {
                  "default": "{toggle.border.color.hover}",
                  "forcedColors": "SelectedItem"
                }
              }
            }
          },
          "$type": "color"
        },
        "active": {
          "$value": "{toggle.dot.background.color.@base}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{toggle.dot.background.color.@base}",
              "forcedColors": "{color.accent.primary.active}",
              "nova": {
                "comment": "HCM colors for toggle need to be updated in Figma",
                "value": {
                  "default": "{toggle.border.color.active}",
                  "forcedColors": "SelectedItem"
                }
              }
            }
          },
          "$type": "color"
        },
        "on-pressed": {
          "$value": "{background.color.canvas}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{background.color.canvas}",
              "forcedColors": "{button.background.color.@base}",
              "nova": {
                "comment": "HCM colors for toggle need to be updated in Figma",
                "value": {
                  "default": "{background.color.box.@base}",
                  "forcedColors": "ButtonText"
                }
              }
            }
          },
          "$type": "color"
        }
      }
    },
    "margin": {
      "$value": "1px",
      "$type": "dimension"
    },
    "height": {
      "$value": "calc({toggle.height} - 2 * {toggle.dot.margin} - 2 * {toggle.border.width})",
      "$type": "dimension"
    },
    "width": {
      "$value": "{toggle.dot.height}",
      "$type": "dimension"
    },
    "transform-x": {
      "$value": "calc({toggle.width} - 2 * {toggle.dot.margin} - 2px - {toggle.dot.width})"
    }
  },
  "inset": {
    "$value": "-2px",
    "$type": "dimension"
  },
  "opacity": {
    "disabled": {
      "$value": "{button.opacity.disabled}",
      "$type": "number"
    }
  }
}
