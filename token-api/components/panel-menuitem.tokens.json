{
  "border": {
    "radius": {
      "$value": "{border.radius.small}",
      "$type": "dimension"
    }
  },
  "margin": {
    "@base": {
      "$value": "0 {panel-menuitem.margin.inline}",
      "$description": "Block margin must be 0 so that there's always an item highlighted and no dead space when moving the pointer across items.",
      "$type": "dimension"
    },
    "inline": {
      "$value": "8px",
      "$type": "dimension"
    }
  },
  "padding": {
    "@base": {
      "$value": "{panel-menuitem.padding.block} {panel-menuitem.padding.inline}",
      "$type": "dimension"
    },
    "block": {
      "$value": "8px",
      "$type": "dimension"
    },
    "inline": {
      "$value": "8px",
      "$type": "dimension"
    }
  }
}
