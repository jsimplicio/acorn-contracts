{
  "background": {
    "color": {
      "@base": {
        "$value": "{popup.background.color}",
        "$extensions": {
          "org.mozilla.themes": {
            "nativeTheme": "Field",
            "default": "{popup.background.color}"
          }
        },
        "$type": "color"
      }
    }
  },
  "text": {
    "color": {
      "@base": {
        "$value": "{text.color.@base}",
        "$extensions": {
          "org.mozilla.themes": {
            "nativeTheme": "FieldText",
            "default": "{text.color.@base}"
          }
        },
        "$type": "color"
      }
    }
  }
}
