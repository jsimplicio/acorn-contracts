{
  "background": {
    "color": {
      "@base": {
        "$value": "{color.white.@base}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{color.white.@base}",
            "dark": "rgb(66, 65, 77)",
            "nativeTheme": "Field",
            "forcedColors": "Menu"
          }
        },
        "$type": "color"
      }
    }
  },
  "border": {
    "color": {
      "$value": "{popup.border.color}",
      "$type": "color"
    },
    "radius": {
      "$value": "{popup.border.radius}",
      "$type": "dimension"
    }
  },
  "box": {
    "shadow": {
      "@base": {
        "$value": "0 0 {panel.box.shadow.margin} hsla(0, 0%, 0%, 0.2)"
      },
      "margin": {
        "$value": "4px",
        "$type": "dimension"
      }
    }
  },
  "footer": {
    "background": {
      "color": {
        "$value": "color-mix(in srgb, currentColor 12%, transparent)",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "color-mix(in srgb, currentColor 12%, transparent)",
            "dark": "color-mix(in srgb, currentColor 17%, transparent)",
            "nativeTheme": "color-mix(in srgb, currentColor 17%, transparent)"
          }
        },
        "$type": "color"
      }
    },
    "text": {
      "color": {
        "$value": "inherit",
        "$type": "color"
      }
    }
  },
  "motion": {
    "duration": {
      "enter": {
        "$value": "150ms"
      },
      "exit": {
        "$value": "120ms"
      },
      "fade": {
        "$value": "120ms"
      }
    },
    "easing": {
      "$value": "{motion.easing.emphasized}"
    },
    "scale": {
      "$value": "0.96"
    },
    "translate": {
      "y": {
        "$value": "-4px"
      }
    }
  },
  "padding": {
    "@base": {
      "$value": "16px",
      "$type": "dimension"
    },
    "block": {
      "$value": "4px",
      "$type": "dimension"
    }
  },
  "separator": {
    "color": {
      "$value": "color-mix(in srgb, currentColor 25%, transparent)",
      "$extensions": {
        "org.mozilla.themes": {
          "default": "color-mix(in srgb, currentColor 25%, transparent)",
          "prefersContrast": "currentColor",
          "forcedColors": "{border.color.@base}"
        },
        "org.mozilla.meta": {
          "ignoreFigma": "color-mix with currentColor cannot be expressed in Figma"
        }
      },
      "$type": "color"
    },
    "padding": {
      "@base": {
        "$value": "{panel.separator.padding.block} {panel.separator.padding.inline}",
        "$type": "dimension"
      },
      "block": {
        "$value": "4px",
        "$type": "dimension"
      },
      "inline": {
        "$value": "8px",
        "$type": "dimension"
      }
    }
  },
  "text": {
    "color": {
      "@base": {
        "$value": "{color.black.@base}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{color.black.@base}",
            "dark": "rgb(251, 251, 254)",
            "nativeTheme": "FieldText",
            "forcedColors": "MenuText"
          }
        },
        "$type": "color"
      }
    }
  },
  "width": {
    "$value": "initial",
    "$type": "dimension"
  }
}
