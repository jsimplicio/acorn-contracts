          }
        },
        "$type": "color"
      },
      "text": {
        "@base": {
          "$value": "{color.white.@base}",
          "$extensions": {
            "org.mozilla.themes": {
              "light": "{color.white.@base}",
              "dark": "{color.blue.90}"
            }
          },
          "$type": "color"
        }
      },
      "hover": {
        "$value": "{color.blue.60}",
        "$extensions": {
