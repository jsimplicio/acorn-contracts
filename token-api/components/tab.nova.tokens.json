{
  "margin": {
    "block": {
      "$value": "6px",
      "$type": "dimension"
    }
  },
  "border": {
    "color": {
      "selected": {
        "leading": {
          "$value": "{color.violet.30}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{color.violet.30}",
              "forcedColors": "{border.color.@base}"
            }
          },
          "$type": "color"
        },
        "trailing": {
          "$value": "{color.orange.30}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{color.orange.30}",
              "forcedColors": "{border.color.@base}"
            }
          },
          "$type": "color"
        }
      }
    }
  },
  "box": {
    "shadow": {
      "selected": {
        "$value": "none"
      }
    }
  },
  "outline": {
    "offset": {
      "$value": "-1px",
      "$type": "dimension"
    }
  },
  "group": {
