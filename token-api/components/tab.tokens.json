{
  "margin": {
    "block": {
      "$value": "4px",
      "$type": "dimension"
    }
  },
  "border": {
    "radius": {
      "$value": "{toolbarbutton.border.radius}",
      "$type": "dimension"
    },
    "color": {
      "accent": {
        "$value": "unset",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "unset",
            "nova": {
              "comment": "This linear-gradient cannot be expressed in Figma",
              "value": "linear-gradient(96deg, {tab.border.color.selected.leading} 20.68%, {tab.border.color.selected.trailing} 79.34%)"
            }
          },
          "org.mozilla.meta": {
            "override": true
          }
        },
        "$type": "color"
      },
      "selected": {
        "leading": {
          "$value": "unset",
          "$type": "color",
          "$extensions": {
            "org.mozilla.meta": {
              "override": true
            }
          }
        },
        "trailing": {
          "$value": "unset",
          "$type": "color",
          "$extensions": {
            "org.mozilla.meta": {
              "override": true
            }
          }
        }
      }
    }
  },
  "box": {
    "shadow": {
      "selected": {
        "$value": "{box-shadow.level-1}"
      }
    }
  },
  "attention": {
    "dot": {
      "color": {
        "$value": "{color.accent.attention}",
        "$type": "color"
      }
    }
  },
  "close": {
    "button": {
      "padding": {
        "$value": "6px",
        "$type": "dimension"
      }
    }
  },
  "hover": {
    "outline": {
      "color": {
        "$value": "transparent",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "transparent",
            "prefersContrast": "currentColor"
          }
        },
        "$type": "color"
      }
    }
  },
  "background": {
    "color": {
      "hover": {
        "$value": "color-mix(in srgb, currentColor 11%, transparent)",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "color-mix(in srgb, currentColor 11%, transparent)",
            "nova": {
              "comment": "color-mix with currentColor cannot be expressed in Figma",
              "value": {
                "nativeTheme": "color-mix(in srgb, currentColor 17%, transparent)",
                "default": "{toolbarbutton.background.color.hover}"
              }
            }
          }
        },
        "$type": "color"
      },
      "selected": {
        "$value": "{color.white.@base}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{color.white.@base}",
            "dark": "rgba(106, 106, 120, 0.7)",
            "nativeTheme": "{toolbar.background.color}",
            "nova": {
              "comment": "Tab HCM overrides are handled in CSS, so we don't want the forcedColors value from Figma",
              "value": {
                "nativeTheme": "{toolbar.background.color}",
                "default": "{background.color.box.@base}"
              }
            }
          }
        },
        "$type": "color"
      }
    }
  },
  "icon": {
    "end": {
      "margin": {
        "$value": "5.5px",
        "$type": "dimension"
      }
    }
  },
  "inline": {
    "padding": {
      "$value": "8px",
      "$type": "dimension"
    }
  },
  "inner": {
    "inline": {
      "margin": {
        "$value": "{space.medium}",
        "$type": "dimension"
      }
    }
  },
  "label": {
    "line": {
      "height": {
        "$value": 1.7,
        "$type": "dimension"
      }
    }
  },
  "loading": {
    "fill": {
      "$value": "{color.blue.50}",
      "$extensions": {
        "org.mozilla.themes": {
          "default": "{color.blue.50}",
          "nova": {
            "comment": "Tab HCM overrides are handled in CSS, so we don't want the forcedColors value from Figma",
            "value": "{color.accent.primary.@base}"
          }
        }
      },
      "$type": "color"
    }
  },
  "outline": {
    "@base": {
      "$value": "{border.width} solid {tab.outline.color}"
    },
    "color": {
      "$value": "transparent",
      "$type": "color",
      "$extensions": {
        "org.mozilla.meta": {
          "ignoreFigma": "Tab HCM overrides are handled in CSS, so we don't want the forcedColors value from Figma"
        }
      }
    },
    "offset": {
      "$value": "calc(-1 * {border.width})",
      "$type": "dimension"
    }
  },
  "overflow": {
    "clip": {
      "margin": {
        "$value": "2px",
        "$type": "dimension"
      }
    }
  },
  "pinned": {
    "container": {
      "margin": {
        "inline": {
          "expanded": {
            "$value": "{space.small}",
            "$type": "dimension"
          }
        }
      }
    },
    "expanded": {
      "background": {
        "width": {
          "$value": "40px",
          "$type": "dimension"
        }
      }
    },
    "margin": {
      "inline": {
        "expanded": {
          "$value": "{space.xsmall}",
          "$type": "dimension"
        }
      }
    }
  },
  "selected": {
    "outline": {
      "color": {
        "$value": "transparent",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "transparent",
            "prefersContrast": "currentColor"
          }
        },
        "$type": "color"
      }
    },
    "textcolor": {
      "$value": "rgb(21, 20, 26)",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "rgb(21, 20, 26)",
          "dark": "{color.white.@base}",
          "nativeTheme": "{toolbar.text.color}"
        }
      },
      "$type": "color"
    }
  },
  "vertical": {
    "block": {
      "margin": {
        "$value": "2px",
        "$type": "dimension"
      }
    },
    "inline": {
      "padding": {
        "$value": "{space.medium}",
        "$type": "dimension"
      }
    }
  },
