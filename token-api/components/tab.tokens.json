{
  "attention": {
    "dot": {
      "color": {
        "$value": "{color.accent.attention}",
        "$type": "color"
      }
    }
  },
  "background": {
    "color": {
      "@base": {
        "$value": "transparent",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "transparent",
            "nativeTheme": "transparent",
            "forcedColors": "{button.background.color.@base}"
          }
        },
        "$type": "color"
      },
      "hover": {
        "$value": "color-mix(in srgb, currentColor 11%, transparent)",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "color-mix(in srgb, currentColor 11%, transparent)",
            "forcedColors": "{button.background.color.hover}",
            "nova": {
              "comment": "color-mix with currentColor cannot be expressed in Figma",
              "value": {
                "nativeTheme": "color-mix(in srgb, currentColor 17%, transparent)",
                "default": "{toolbarbutton.background.color.hover}"
              }
            }
          }
        },
        "$type": "color"
      },
      "selected": {
        "$value": "{color.white.@base}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{color.white.@base}",
            "dark": "rgba(106, 106, 120, 0.7)",
            "nativeTheme": "{toolbar.background.color}",
            "forcedColors": "SelectedItem"
          }
        },
        "$type": "color"
      },
      "pinned": {
        "$value": "unset",
        "$type": "color",
        "$extensions": {
          "org.mozilla.meta": {
            "override": true
          }
        }
      }
    },
    "width": {
      "pinned": {
        "expanded": {
          "$value": "40px",
          "$type": "dimension"
        }
      }
    }
  },
  "border": {
    "@base": {
      "$value": "{border.width} solid {tab.border.color.@base}"
    },
    "radius": {
      "$value": "{toolbarbutton.border.radius}",
      "$type": "dimension"
    },
    "color": {
      "@base": {
        "$value": "{toolbarbutton.outline.color.@base}",
        "$type": "color"
      },
      "hover": {
        "$value": "{toolbarbutton.outline.color.hover}",
        "$type": "color"
      },
      "accent": {
        "$value": "unset",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "unset",
            "nova": {
              "comment": "This linear-gradient cannot be expressed in Figma",
              "value": "linear-gradient(96deg, {tab.border.color.selected.leading} 20.68%, {tab.border.color.selected.trailing} 79.34%)"
            }
          },
          "org.mozilla.meta": {
            "override": true
          }
        },
        "$type": "color"
      },
      "selected": {
        "@base": {
          "$value": "{toolbarbutton.outline.color.selected}",
          "$type": "color",
          "$extensions": {
            "org.mozilla.meta": {
              "ignoreFigma": "Figma uses a gradient, so its values are empty"
            }
          }
        },
        "leading": {
          "$value": "unset",
          "$type": "color",
          "$extensions": {
            "org.mozilla.meta": {
              "override": true
            }
          }
        },
        "trailing": {
          "$value": "unset",
          "$type": "color",
          "$extensions": {
            "org.mozilla.meta": {
              "override": true
            }
          }
        }
      }
    }
  },
  "box": {
    "shadow": {
      "selected": {
        "$value": "{box-shadow.level-1}"
      }
    }
  },
  "close": {
    "button": {
      "padding": {
        "$value": "6px",
        "$type": "dimension"
      },
      "background": {
        "color": {
          "@base": {
            "$value": "{button.background.color.ghost.@base}",
            "$type": "color"
          },
          "hover": {
            "$value": "{toolbarbutton.background.color.hover}",
            "$type": "color"
          },
          "active": {
            "$value": "{toolbarbutton.background.color.active}",
            "$type": "color"
          }
        }
      },
      "border": {
        "color": {
          "@base": {
            "$value": "{tab.border.color.@base}",
            "$type": "color"
          },
          "hover": {
            "$value": "{tab.border.color.@base}",
            "$extensions": {
              "org.mozilla.themes": {
                "default": "{tab.border.color.@base}",
                "prefersContrast": "{button.border.color.hover}"
              }
            },
            "$type": "color"
          },
          "active": {
            "$value": "{tab.border.color.@base}",
            "$extensions": {
              "org.mozilla.themes": {
                "default": "{tab.border.color.@base}",
                "prefersContrast": "{button.border.color.active}"
              }
            },
            "$type": "color"
          }
        }
      },
      "text": {
        "color": {
          "@base": {
            "$value": "{tab.text.color.@base}",
            "$type": "color"
          },
          "hover": {
            "$value": "{tab.text.color.@base}",
            "$extensions": {
              "org.mozilla.themes": {
                "default": "{tab.text.color.@base}",
                "forcedColors": "{button.text.color.hover}"
              }
            },
            "$type": "color"
          },
          "active": {
            "$value": "{tab.text.color.@base}",
            "$extensions": {
              "org.mozilla.themes": {
                "default": "{tab.text.color.@base}",
                "forcedColors": "{button.text.color.active}"
              }
            },
            "$type": "color"
          }
        }
      }
    }
  },
  "container": {
    "margin": {
      "inline": {
        "pinned": {
          "expanded": {
            "$value": "{space.small}",
            "$extensions": {
              "org.mozilla.themes": {
                "default": "{space.small}",
                "nova": {
                  "comment": "This token's name needs to be updated in Figma to match.",
                  "value": "4px"
                }
              }
            },
            "$type": "dimension"
          }
        }
      }
    }
  },
  "icon": {
    "fill": {
      "loading": {
        "$value": "{color.blue.50}",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "{color.blue.50}",
            "nova": {
              "comment": "Tab HCM overrides are handled in CSS, so we don't want the forcedColors value from Figma",
              "value": "{color.accent.primary.@base}"
            }
          }
        },
        "$type": "color"
      }
    },
    "margin": {
      "inline": {
        "end": {
          "$value": "5.5px",
          "$type": "dimension"
        }
      }
    }
  },
  "label": {
    "line": {
      "height": {
        "$value": 1.7,
        "$type": "dimension"
      }
    }
  },
  "margin": {
    "block": {
      "@base": {
        "$value": "4px",
        "$type": "dimension"
      },
      "vertical": {
        "$value": "2px",
        "$type": "dimension"
      }
    },
    "inline": {
      "inner": {
        "$value": "{space.medium}",
        "$type": "dimension",
        "$extensions": {
          "org.mozilla.meta": {
            "ignoreFigma": "Prefer space token over pixel value from Figma."
          }
        }
      },
      "pinned": {
        "expanded": {
          "$value": "{space.xsmall}",
          "$type": "dimension",
          "$extensions": {
            "org.mozilla.meta": {
              "ignoreFigma": "The 0px value from Figma causes pinned tabs to touch."
            }
          }
        }
      }
    },
    "overflow": {
      "clip": {
        "$value": "2px",
        "$type": "dimension"
      }
    }
  },
  "outline": {
    "offset": {
      "$value": "calc(-1 * {border.width})",
      "$type": "dimension"
    }
  },
  "padding": {
    "inline": {
      "@base": {
        "$value": "8px",
        "$type": "dimension"
      },
      "vertical": {
        "$value": "{space.medium}",
        "$type": "dimension"
      }
    }
  },
  "text": {
    "color": {
      "@base": {
        "$value": "{toolbox.text.color.current}",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "{toolbox.text.color.current}",
            "forcedColors": "{button.text.color.@base}"
          }
        },
        "$type": "color"
      },
      "hover": {
        "$value": "{toolbox.text.color.current}",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "{toolbox.text.color.current}",
            "forcedColors": "{button.text.color.hover}"
          }
        },
        "$type": "color"
      },
      "selected": {
        "$value": "rgb(21, 20, 26)",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "rgb(21, 20, 26)",
            "dark": "{color.white.@base}",
            "nativeTheme": "{toolbar.text.color}",
            "forcedColors": "SelectedItemText"
          }
        },
        "$type": "color"
      }
    }
  },
