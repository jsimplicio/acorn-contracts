{
  "background": {
    "color": {
      "$value": "#f8f8fa",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "#f8f8fa",
          "dark": "rgb(35, 34, 43)",
          "forcedColors": "Canvas"
        }
      },
      "$type": "color"
    }
  },
  "border": {
    "color": {
      "$value": "color-mix(in srgb, currentColor 41%, transparent)",
      "$extensions": {
        "org.mozilla.themes": {
          "default": "color-mix(in srgb, currentColor 41%, transparent)",
          "forcedColors": "CanvasText"
        }
      },
      "$type": "color"
    }
  },
  "header": {
    "background": {
      "color": {
        "$value": "{color.accent.primary.@base}",
        "$extensions": {
          "org.mozilla.themes": {
            "default": "{color.accent.primary.@base}",
            "forcedColors": "AccentColor"
          }
        },
        "$type": "color"
      }
    },
    "text": {
      "color": {
        "@base": {
          "$value": "{color.white.@base}",
          "$extensions": {
            "org.mozilla.themes": {
              "forcedColors": "AccentColorText",
              "brand": {
                "light": "{color.white.@base}",
                "dark": "{color.gray.100}"
              },
              "platform": {
                "default": "AccentColorText"
              }
            }
          },
          "$type": "color"
        }
      }
    }
  },
  "row": {
    "background": {
      "color": {
        "@base": {
          "$value": "{background.color.canvas}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{background.color.canvas}"
            }
          },
          "$type": "color"
        },
        "alternate": {
          "$value": "#f0f0f4",
          "$extensions": {
            "org.mozilla.themes": {
              "forcedColors": "{background.color.canvas}",
              "brand": {
                "light": "#f0f0f4",
                "dark": "{color.gray.80}"
              },
              "platform": {
                "light": "rgba(0, 0, 0, 0.05)",
                "dark": "rgba(255, 255, 255, 0.05)"
              }
            }
          },
          "$description": "TODO Bug 1821203 - Gray use needs to be consolidated",
          "$type": "color"
        }
      }
    }
  }
}
