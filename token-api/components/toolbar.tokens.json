{
  "padding": {
    "inline": {
      "$value": "8px",
      "$type": "dimension"
    }
  },
  "field": {
    "border": {
      "color": {
        "@base": {
          "$value": "{border.color.transparent}",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "{border.color.transparent}",
              "nativeTheme": "{border.color.transparent}",
              "prefersContrast": "{input.border.color}"
            }
          },
          "$type": "color"
        },
        "focus": {
          "$value": "color-mix(in srgb, {focus.outline.color} 50%, transparent)",
          "$extensions": {
            "org.mozilla.themes": {
              "default": "color-mix(in srgb, {focus.outline.color} 50%, transparent)",
              "prefersContrast": "{focus.outline.color}",
              "nova": {
                "comment": "color-mix cannot be expressed in Figma",
                "value": {
                  "nativeTheme": "color-mix(in srgb, {focus.outline.color} 50%, transparent)",
                  "default": "{focus.outline.color}",
                  "prefersContrast": "{focus.outline.color}"
                }
              }
            }
          },
          "$type": "color"
        }
      }
    },
    "background": {
      "color": {
        "@base": {
          "$value": "rgba(0, 0, 0, 0.05)",
          "$extensions": {
            "org.mozilla.themes": {
              "light": "rgba(0, 0, 0, 0.05)",
              "dark": "{color.black.alpha.30}",
              "nativeTheme": "light-dark(rgba(0, 0, 0, 0.05), {color.black.alpha.30})",
              "prefersContrast": "Field"
            }
          },
          "$type": "color"
        },
        "focus": {
          "$value": "{color.white.@base}",
          "$extensions": {
            "org.mozilla.themes": {
              "light": "{color.white.@base}",
              "dark": "rgb(66, 65, 77)",
              "nativeTheme": "Field"
            }
          },
          "$type": "color"
        }
      }
    },
    "text": {
      "color": {
        "@base": {
          "$value": "{color.gray.100}",
          "$extensions": {
            "org.mozilla.themes": {
              "light": "{color.gray.100}",
              "dark": "{color.gray.0}",
              "nativeTheme": "inherit",
              "prefersContrast": "FieldText"
            }
          },
          "$type": "color"
        },
        "focus": {
          "$value": "{color.black.@base}",
          "$extensions": {
            "org.mozilla.themes": {
              "light": "{color.black.@base}",
              "dark": "{color.gray.0}",
              "nativeTheme": "FieldText"
            }
          },
          "$type": "color"
        }
      }
    }
  },
  "background": {
    "color": {
      "$value": "#f9f9fb",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "#f9f9fb",
          "dark": "rgb(43, 42, 51)",
          "nativeTheme": "color-mix(in srgb, -moz-dialog 85%, {color.white.@base})"
        }
      },
      "$type": "color"
    }
  },
  "text": {
    "color": {
      "$value": "{color.gray.100}",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "{color.gray.100}",
          "dark": "{color.gray.0}",
          "nativeTheme": "-moz-dialogtext"
        }
      },
      "$type": "color"
    }
  }
}
