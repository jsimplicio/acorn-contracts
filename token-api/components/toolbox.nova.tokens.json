{
  "background": {
    "color": {
      "inactive": {
        "$value": "transparent",
        "$extensions": {
          "org.mozilla.themes": {
            "nativeTheme": "-moz-headerbarinactive",
            "default": "transparent"
          }
        },
        "$type": "color"
      },
      "gradient-leading": {
        "$value": "{color.violet.10}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{color.violet.10}",
            "dark": "{color.violet-desaturated.70}",
            "forcedColors": "Canvas"
          }
        },
        "$type": "color"
      },
      "gradient-trailing": {
        "$value": "{color.orange.10}",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "{color.orange.10}",
            "dark": "{color.orange.70}",
            "forcedColors": "Canvas"
          }
        },
        "$type": "color"
      }
    }
  },
  "text": {
    "color": {
      "@base": {
        "$value": "{text.color.@base}",
        "$extensions": {
          "org.mozilla.themes": {
            "nativeTheme": "-moz-headerbartext",
            "default": "{text.color.@base}"
          }
        },
        "$type": "color"
      },
      "current": {
        "$value": "{toolbox.text.color.@base}",
        "$description": "Figma aliases this to toolbox/text/color so designers see a real color, but CSS must use currentColor: the tab inherits --lwt-text-color under an lwtheme and --toolbox-text-color-inactive in a background window, neither of which --toolbox-text-color tracks. Listed in figma-import.mjs's FIGMA_IGNORES so the alias doesn't overwrite this.",
        "$type": "color"
      }
    }
  }
}
