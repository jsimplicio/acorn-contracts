{
  "background": {
    "color": {
      "hover": {
        "$value": "rgb(240, 240, 244)",
        "$extensions": {
          "org.mozilla.themes": {
            "nativeTheme": "{background.color.list.item.hover}",
            "light": "rgb(240, 240, 244)",
            "dark": "{background.color.list.item.hover}",
            "prefersContrast": "color-mix(in srgb, currentColor 20%, transparent)",
            "nova": {
              "comment": "TODO(bug 2076362): use the ghost button colors once they follow currentColor",
              "value": {
                "nativeTheme": "{button.background.color.ghost.hover}",
                "light": "color-mix(in srgb, currentColor 17%, transparent)",
                "dark": "color-mix(in srgb, currentColor 20%, transparent)"
              }
            }
          }
        },
        "$type": "color"
      },
      "selected": {
        "$value": "#e0e0e6",
        "$extensions": {
          "org.mozilla.themes": {
            "nativeTheme": "SelectedItem",
            "light": "#e0e0e6",
            "dark": "rgb(43, 42, 51)",
            "prefersContrast": "{background.color.list.item.hover}",
            "nova": {
              "comment": "TODO(bug 2076362): use the ghost button colors once they follow currentColor",
              "value": {
                "nativeTheme": "SelectedItem",
                "light": "color-mix(in srgb, currentColor 27%, transparent)",
                "dark": "color-mix(in srgb, currentColor 32%, transparent)"
              }
            }
          }
        },
        "$type": "color"
      }
    }
  },
  "border": {
    "radius": {
      "$value": "calc({button.border.radius} + 2px)",
      "$type": "dimension"
    }
  },
  "separator": {
    "color": {
      "$value": "rgb(240, 240, 244)",
      "$extensions": {
        "org.mozilla.themes": {
          "light": "rgb(240, 240, 244)",
          "dark": "rgb(82, 82, 94)",
          "nativeTheme": "color-mix(in srgb, currentColor 14%, transparent)",
          "prefersContrast": "color-mix(in srgb, currentColor 86%, transparent)"
        }
      },
      "$type": "color"
    }
  },
  "action": {
    "button": {
      "background": {
        "color": {
          "@base": {
            "$value": "color-mix(in srgb, {color.gray.20} 50%, transparent)",
            "$extensions": {
              "org.mozilla.themes": {
                "nativeTheme": "color-mix(in srgb, currentColor 8.5%, transparent)",
                "light": "color-mix(in srgb, {color.gray.20} 50%, transparent)",
                "dark": "color-mix(in srgb, currentColor 8.5%, transparent)",
                "nova": {
                  "comment": "color-mix with currentColor cannot be expressed in Figma",
                  "value": "{urlbar.box.background.color.@base}"
                }
              }
            },
            "$type": "color"
          },
          "hover": {
            "$value": "{color.gray.20}",
            "$extensions": {
              "org.mozilla.themes": {
                "nativeTheme": "color-mix(in srgb, currentColor 17%, transparent)",
                "light": "{color.gray.20}",
                "dark": "color-mix(in srgb, currentColor 17%, transparent)",
                "nova": {
                  "comment": "color-mix with currentColor cannot be expressed in Figma",
                  "value": "{urlbar.box.background.color.hover}"
                }
              }
            },
            "$type": "color"
          }
        }
      }
    }
  },
  "favicon": {
    "size": {
      "$value": "{icon.size.@base}",
      "$type": "dimension"
    }
  },
  "row": {
    "min": {
      "height": {
        "$value": "{size.item.large}",
        "$type": "dimension"
      }
    },
    "padding": {
      "block": {
        "$value": "{space.small}",
        "$type": "dimension"
      }
    }
  },
  "text": {
    "color": {
      "action": {
        "$value": "rgb(91, 91, 102)",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "rgb(91, 91, 102)",
            "dark": "rgb(191, 191, 201)",
            "nativeTheme": "LinkText"
          }
        },
        "$type": "color"
      },
      "hover": {
        "$value": "currentColor",
        "$type": "color"
      },
      "secondary": {
        "$value": "color-mix(in srgb, currentColor 73%, transparent)",
        "$extensions": {
          "org.mozilla.themes": {
            "nativeTheme": "color-mix(in srgb, currentColor 73%, transparent)",
            "default": "color-mix(in srgb, currentColor 73%, transparent)",
            "forcedColors": "currentColor"
          }
        },
        "$type": "color"
      },
      "selected": {
        "$value": "rgb(21, 20, 26)",
        "$extensions": {
          "org.mozilla.themes": {
            "light": "rgb(21, 20, 26)",
            "dark": "rgb(251, 251, 254)",
            "nativeTheme": "SelectedItemText",
            "prefersContrast": "{text.color.list.item.hover}",
            "nova": {
              "comment": "currentColor resolves where it's used, so the row takes the color of the input the view belongs to",
              "value": {
                "nativeTheme": "SelectedItemText",
                "default": "currentColor"
              }
            }
          }
        },
        "$type": "color"
      }
    }
  }
}
